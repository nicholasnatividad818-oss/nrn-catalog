# Supabase — create a new project at https://supabase.com/dashboard
# Required for auth, RLS, and catalog persistence
# Use the current publishable-key model (Dashboard → Project Settings → API → Publishable key)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_PUBLISHABLE_KEY
# Legacy anon key also supported if you use NEXT_PUBLIC_SUPABASE_ANON_KEY
# Optional local dev fallback uses in-memory store when these are not set
# See supabase/migrations/README.md for how to run migrations
# Do NOT put a service-role/secret key in NEXT_PUBLIC_ vars — server-only if truly needed
