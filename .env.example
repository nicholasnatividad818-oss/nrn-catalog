# Supabase — create a new project at https://supabase.com/dashboard
# Required for auth, RLS, and catalog persistence
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY
# Optional: local dev fallback uses in-memory store when these are not set
# See supabase/migrations/README.md for how to run migrations
